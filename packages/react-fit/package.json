{
  "name": "@guanriyue/react-fit",
  "version": "0.0.0",
  "description": "React components for building UIs that fit, overflow, and adapt to available element space.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src",
    "!src/**/*.spec.ts",
    "!src/**/*.spec.tsx"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./fit-grid": {
      "types": "./src/FitGrid/index.ts",
      "import": "./src/FitGrid/index.ts"
    },
    "./fit-switch": {
      "types": "./src/FitSwitch/index.ts",
      "import": "./src/FitSwitch/index.ts"
    },
    "./compact-grid": {
      "types": "./src/CompactGrid/index.ts",
      "import": "./src/CompactGrid/index.ts"
    },
    "./inline-overflow": {
      "types": "./src/InlineOverflow/index.ts",
      "import": "./src/InlineOverflow/index.ts"
    },
    "./line-clamp": {
      "types": "./src/LineClamp/index.ts",
      "import": "./src/LineClamp/index.ts"
    },
    "./textarea": {
      "types": "./src/Textarea/index.ts",
      "import": "./src/Textarea/index.ts"
    }
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --pool=threads --maxWorkers=1 --no-file-parallelism",
    "lint": "biome check ."
  },
  "keywords": [],
  "author": {
    "name": "guanriyue",
    "url": "https://github.com/guanriyue"
  },
  "license": "MIT",
  "homepage": "https://guanriyue.github.io/element-fit/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guanriyue/element-fit.git",
    "directory": "packages/react-fit"
  },
  "bugs": {
    "url": "https://github.com/guanriyue/element-fit/issues"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./fit-grid": {
        "types": "./dist/FitGrid/index.d.ts",
        "import": "./dist/FitGrid/index.js"
      },
      "./fit-switch": {
        "types": "./dist/FitSwitch/index.d.ts",
        "import": "./dist/FitSwitch/index.js"
      },
      "./compact-grid": {
        "types": "./dist/CompactGrid/index.d.ts",
        "import": "./dist/CompactGrid/index.js"
      },
      "./inline-overflow": {
        "types": "./dist/InlineOverflow/index.d.ts",
        "import": "./dist/InlineOverflow/index.js"
      },
      "./line-clamp": {
        "types": "./dist/LineClamp/index.d.ts",
        "import": "./dist/LineClamp/index.js"
      },
      "./textarea": {
        "types": "./dist/Textarea/index.d.ts",
        "import": "./dist/Textarea/index.js"
      }
    }
  },
  "dependencies": {
    "@guanriyue/resize-observer-hub": "workspace:*",
    "@radix-ui/react-compose-refs": "^1.1.3",
    "@radix-ui/react-primitive": "^2.1.7",
    "clsx": "^2.1.1"
  },
  "devDependencies": {
    "@types/react": "^18.0.0 || ^19.0.0",
    "@types/react-dom": "^18.0.0 || ^19.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  }
}
